[Container]
Image=docker.io/cloudflare/cloudflared:2026.10.7@sha256:4955524aeaa379e154023d5a027c250f7b35041a2e7e950cf13f144bc9b9c5ba
ContainerName=cloudflare-tunnel

Network=cloudflare-tunnel.network

Secret=cloudflare_tunnel_token,target=tunnel_token,uid=65532,gid=65532,mode=0400

Environment=TUNNEL_METRICS=127.0.0.1:60123

ReadOnly=true
ReadOnlyTmpfs=false

User=65532
Group=65532
UserNS=auto
NoNewPrivileges=true
DropCapability=all

Exec=tunnel run --token-file /run/secrets/tunnel_token

HealthStartupCmd=["cloudflared", "tunnel", "ready"]
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthCmd=["cloudflared", "tunnel", "ready"]
HealthInterval=30s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

Memory=256M
PidsLimit=30

[Service]
CPUQuota=100%
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
