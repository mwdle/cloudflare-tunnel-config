[Container]
Image=docker.io/cloudflare/cloudflared:2026.11.2@sha256:55c7e3e8d89d5e8d20b75a82f3602cbf98e06db406e73e282073cfdc5a9a3af6
ContainerName=cloudflare-tunnel

Network=cloudflare-tunnel.network

Secret=cloudflare_tunnel_token,target=tunnel_token,uid=65532,gid=65532,mode=0400

Environment=TUNNEL_METRICS=127.0.0.1:60123

ReadOnly=true
ReadOnlyTmpfs=false

User=65532
Group=65532
UserNS=auto
NoNewPrivileges=true
DropCapability=all

Exec=tunnel run --token-file /run/secrets/tunnel_token

HealthCmd=["cloudflared", "tunnel", "ready"]
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthInterval=30s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

Memory=256M
PidsLimit=30

[Service]
CPUQuota=100%
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
